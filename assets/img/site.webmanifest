---
layout: compress
---

{% assign img_path = "/assets/img" | relative_url %}

{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "icons": [
    {
      "src": "{{ img_path }}/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ img_path }}/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}
